# Gestión
GESTION_DATABASE_URL=replace-with-local-PostgreSQL-connection-string

# Comercio
COMERCIO_DATABASE_URL=replace-with-local-PostgreSQL-connection-string

# Catálogo (MongoDB Atlas)
CATALOGO_MONGO_URI=replace-with-local-MongoDB-connection-string

# Clave compartida para firmar y validar los JWT (la misma en Gestión y Comercio)
JWT_SIGNING_KEY=replace-with-a-random-secret

# Correo (activación de cuentas y recuperación de contraseña).
# Sin EMAIL_BACKEND los correos se imprimen en la consola. Para envío real usa
# django.core.mail.backends.smtp.EmailBackend con los datos que entrega el equipo
# por un canal seguro; van solo en tu .env local, nunca en el repositorio.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=replace-with-smtp-host
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
EMAIL_HOST_USER=replace-with-smtp-user
EMAIL_HOST_PASSWORD=replace-with-smtp-password
DEFAULT_FROM_EMAIL=Todo Balato <no-reply@example.com>

# URL del frontend; los enlaces de los correos apuntan a ella
FRONTEND_URL=http://localhost:5173
