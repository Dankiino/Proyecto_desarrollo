# Gestión
GESTION_DATABASE_URL=replace-with-local-PostgreSQL-connection-string

# Comercio
COMERCIO_DATABASE_URL=replace-with-local-PostgreSQL-connection-string

CATALOGO_API_URL=http://localhost:8002/api

# Clave compartida para firmar y validar los JWT (la misma en Gestión y Comercio)
JWT_SIGNING_KEY=replace-with-a-random-secret

# URL del servicio de Gestión (verifica que la cuenta siga activa en cada solicitud)
GESTION_URL=http://127.0.0.1:8000


# Webpay Plus (ambiente de prueba; credenciales de sandbox por canal seguro del equipo)
WEBPAY_COMMERCE_CODE=replace-with-sandbox-commerce-code
WEBPAY_API_KEY=replace-with-sandbox-api-key
WEBPAY_RETURN_URL=http://127.0.0.1:8001/api/pagos/webpay/retorno
FRONTEND_RESULT_URL=http://localhost:5173/pago/resultado
